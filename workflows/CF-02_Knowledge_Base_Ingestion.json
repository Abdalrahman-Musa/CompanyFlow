    {
      "parameters": {
        "jsCode": "// CF-02 · \"Build Role-tagged Job Chunks\" — one chunk per JD section, each prefixed with a role\n// header and carrying job_id / role_family / seniority metadata. A dedicated \"how this role\n// differs\" chunk is what lets retrieval separate look-alike roles (SOC-L1 vs SOC-L2 …).\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const header = `[Role: ${j.title} | Job ID: ${j.id} | Family: ${j.role_family} | Seniority: ${j.seniority} | Department: ${j.department} | Min years: ${j.min_years}]`;\n  const desc = String(j.description || '');\n  // split the JD on its section headings\n  const parts = desc.split(/\\n(?=(About the role|Responsibilities|Requirements \\(must have\\)|Nice to have|Experience:))/).filter(p => p && !/^(About the role|Responsibilities|Requirements \\(must have\\)|Nice to have|Experience:)$/.test(p.trim()));\n  const sections = parts.map(p => p.trim()).filter(p => p.length > 30);\n  sections.unshift(`Summary: ${j.summary}`);\n  sections.push(`How ${j.title} (${j.id}) differs from similar roles: ${j.distinguishing_notes || ''}`);\n  const mh = (j.must_have_skills || []).map(g => g.label).join(', ');\n  const nh = (j.nice_to_have_skills || []).map(g => g.label).join(', ');\n  sections.push(`Structured requirements for ${j.id}: must-have — ${mh}. Nice-to-have — ${nh}. Minimum relevant experience: ${j.min_years} years.`);\n  sections.forEach((s, i) => out.push({ json: {\n    chunk_text: header + '\\n' + s,\n    job_id: j.id, title: j.title, role_family: j.role_family, seniority: j.seniority,\n    department: j.department, section_no: i + 1,\n    section_kind: i === 0 ? 'summary' : s.startsWith('How ') ? 'distinguishing' : s.startsWith('Structured') ? 'requirements' : 'description',\n    source: 'jobs_table'\n  } }));\n}\nreturn out;\n"
      },
      "id": "93fefbe8-3696-4183-b648-e45af288ab6f",
      "name": "Build Role-tagged Job Chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        720
      ]
    },
