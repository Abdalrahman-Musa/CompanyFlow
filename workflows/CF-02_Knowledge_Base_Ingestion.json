      "parameters": {
        "jsCode": "// CF-02 · \"Normalize Extracted Text\" — one place that validates whatever the extractor produced\nconst j = $input.first().json;\nconst form = $('Upload HR Document').first().json;\nconst text = String(j.text ?? j.data ?? '').replace(/\\u0000/g, '');\nconst clean = text.replace(/[ \\t]+/g, ' ').trim();\nif (clean.length < 200) {\n  throw new Error(`The document has only ${clean.length} characters of text. If it is a scanned PDF, export it as a text-based PDF or upload the .md/.txt version.`);\n}\nreturn [{ json: {\n  text,\n  chars: clean.length,\n  pages: j.numpages || null,\n  doc_title: String(form['Document title'] || 'CompanyFlow Employee Handbook').trim().slice(0, 120),\n  version: String(form['Version'] || 'unversioned').trim().slice(0, 30),\n  uploaded_by: String(form['Uploaded by'] || 'HR admin').trim().slice(0, 80),\n} }];\n"
      },
      "id": "5f7db5dc-f6d0-4231-b168-179218c9fa19",
