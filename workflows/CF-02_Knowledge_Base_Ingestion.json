      "parameters": {
        "jsCode": "// CF-02 · \"Section-aware Chunker\" — splits the handbook by numbered / markdown headings and\n// prefixes every chunk with its document + section so retrieval and citations stay precise.\nconst src = $('Normalize Extracted Text').first().json;\nconst docTitle = src.doc_title;\nconst version = src.version;\nlet text = src.text;\n\n// remove repeated page headers/footers and page numbers produced by PDF extraction\nconst lines = text.replace(/\\r/g, '').split('\\n').map(l => l.trim());\nconst freq = {}; for (const l of lines) if (l) freq[l] = (freq[l] || 0) + 1;\nconst clean = lines.filter(l => !/^page \\d+( of \\d+)?$/i.test(l) && !(l.length < 120 && freq[l] >= 3));\n\n// heading detection: \"## 3. Leave Policy\", \"### 3.1 Annual leave\", \"3.1 Annual leave\", \"3. Leave Policy\"\nconst H = /^(?:#{1,4}\\s*)?(\\d{1,2}(?:\\.\\d{1,2})*)\\.?\\s+([A-Z][^.!?]{2,80})$/;\nconst chunks = []; let top = ''; let cur = null;\nconst push = () => { if (cur && cur.body.join(' ').trim().length > 20) chunks.push(cur); };\nfor (const l of clean) {\n  const m = l.match(H);\n  if (m) {\n    push();\n    const num = m[1]; const title = m[2].replace(/^#+\\s*/, '').trim();\n    if (!num.includes('.')) top = num + '. ' + title;\n    cur = { section: num, title, parent: num.includes('.') ? top : '', body: [] };\n  } else if (l && !/^#\\s/.test(l)) {\n    if (!cur) cur = { section: '0', title: 'Introduction', parent: '', body: [] };\n    cur.body.push(l.replace(/^[-•*]\\s*/, '• '));\n  }\n}\npush();\nif (!chunks.length) throw new Error('No sections detected. Use numbered headings like \"3.1 Annual leave\".');\n\nreturn chunks.map((c, i) => {\n  const header = `[${docTitle} v${version} | Section ${c.section} ${c.title}${c.parent ? ' | Part of ' + c.parent : ''}]`;\n  return { json: {\n    chunk_text: header + '\\n' + c.body.join('\\n'),\n    doc_title: docTitle, version, section: c.section, section_title: c.title,\n    parent_section: c.parent, chunk_no: i + 1, chunks_total: chunks.length,\n    uploaded_by: src.uploaded_by, uploaded_at: new Date().toISOString()\n  } };\n});\n"
      },
