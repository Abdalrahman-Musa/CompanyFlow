    {
      "parameters": {
        "jsCode": "const r = $('Book Slot (atomic)').first().json.result;\nlet meet = null, sent = false;\ntry { meet = $('Create Calendar Event').first().json.hangoutLink || null; } catch (e) {}\ntry { sent = !!$('Email Candidate Confirmation').first().json.id; } catch (e) {}\n// no candidate e-mail in the result that goes back to the AI agent\nreturn [{ json: { ok: true, app_code: r.app_code, job_title: r.job_title, interview: { when: r.interview.when, mode: r.interview.mode, location: r.interview.location, interviewer: r.interview.interviewer_name, meet_link: meet }, email_sent: sent } }];"
      },
