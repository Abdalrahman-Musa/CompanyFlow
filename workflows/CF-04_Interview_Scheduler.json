          "description": "=CompanyFlow interview for application {{ $json.result.app_code }} ({{ $json.result.job_title }}). Mode: {{ $json.result.interview.mode }}. Location: {{ $json.result.interview.location }}. Candidate details are in the HR dashboard.",
          "location": "={{ $json.result.interview.location }}",
          "attendees": [
