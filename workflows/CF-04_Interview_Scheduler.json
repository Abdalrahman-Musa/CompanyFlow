    {
      "parameters": {
        "jsCode": "// CF-04 · \"Validate Request\" — the scheduler never trusts its caller blindly\nconst j = $input.first().json;\nconst action = String(j.action || '').toLowerCase().trim();\nconst appId = parseInt(j.application_id, 10);\nconst slotId = parseInt(j.slot_id, 10);\nconst role = String(j.actor_role || '');\nconst errors = [];\nif (!['list_slots', 'book'].includes(action)) errors.push('action must be list_slots or book');\nif (!Number.isInteger(appId) || appId <= 0) errors.push('application_id must be a positive number');\nif (action === 'book' && (!Number.isInteger(slotId) || slotId <= 0)) errors.push('slot_id is required to book');\nif (!['candidate', 'hr'].includes(role)) errors.push('actor_role must be candidate or hr');\nif (!j.actor_id) errors.push('actor_id is required');\nreturn [{ json: { valid: errors.length === 0, errors, action, application_id: appId, slot_id: slotId || null, actor_id: String(j.actor_id || ''), actor_role: role } }];\n"
      },
