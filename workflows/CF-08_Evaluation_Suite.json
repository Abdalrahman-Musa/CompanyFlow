    {
      "parameters": {
        "jsCode": "// CF-08 · \"Role Disambiguation Queries\" — each query describes ONE of two look-alike roles\nconst Q = [\n  ['Monitor SIEM alerts on shift, triage them and escalate confirmed incidents to the next tier; fresh graduates welcome', 'SOC-L1'],\n  ['Lead containment and eradication of escalated incidents with EDR, run threat hunts and write correlation rules; 3+ years', 'SOC-L2'],\n  ['Which security role investigates and contains incidents instead of only monitoring the alert queue?', 'SOC-L2'],\n  ['Answer business questions with SQL and Excel and present simple dashboards to managers; junior, internships count', 'DA-JR'],\n  ['Design star-schema models, build SSIS / Azure Data Factory ETL pipelines and enterprise Power BI semantic models with DAX', 'BI-DEV'],\n  ['Which data role builds the data warehouse, ETL and semantic models rather than doing ad-hoc analysis?', 'BI-DEV'],\n  ['Handle inbound calls and chats about orders, refunds and billing for an English-speaking international client', 'CS-EN'],\n  ['Fix laptops, Microsoft 365, VPN and Active Directory account problems and close tickets within SLA', 'TS-L1'],\n];\nreturn Q.map(([query, expected], i) => ({ json: { n: i + 1, query, expected } }));\n"
      },
      "id": "c35cbcf2-4b97-4ecc-aa24-86751c257f69",
      "name": "Role Disambiguation Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        -60
      ]
    },
