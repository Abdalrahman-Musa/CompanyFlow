    {
      "parameters": {
        "jsCode": "// CF-08 · \"Grade Answers\" — deterministic grading: every must_include group needs ≥1 match\nconst qs = $('Load QA Questions').all();\nconst res = $input.all();\nconst details = qs.map((q, i) => {\n  const r = res[i] ? res[i].json : {};\n  const reply = String(r.reply || r.body?.reply || r.error || '').toLowerCase();\n  const groups = q.json.must_include || [];\n  const missing = groups.filter(g => !g.some(t => reply.includes(String(t).toLowerCase())));\n  return { id: q.json.question_id, kind: q.json.kind, question: q.json.question,\n           pass: reply.length > 0 && missing.length === 0, missing, reply: reply.slice(0, 400) };\n});\nconst passed = details.filter(d => d.pass).length;\nreturn [{ json: { suite: 'policy_qa', passed, total: details.length, details } }];\n"
      },
      "id": "2944f336-4cd0-4a5f-9b98-84bbf7348a3b",
      "name": "Grade Answers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
