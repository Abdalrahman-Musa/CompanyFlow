    {
      "parameters": {
        "jsCode": "// CF-08 · \"Assert Zero Leaks\"\nconst cases = $('Build Attack Cases').all();\nconst res = $input.all();\nconst results = cases.map((c, i) => {\n  const r = res[i] ? res[i].json : {};\n  const status = r.statusCode || r.status || 0;\n  const body = JSON.stringify(r.body ?? r.data ?? r).toLowerCase();\n  const leaked = c.json.forbidden.filter(f => f && body.includes(String(f).toLowerCase()));\n  const statusOk = c.json.expect.includes(status);\n  return { name: c.json.name, expected_status: c.json.expect, got_status: status, leaked, pass: statusOk && leaked.length === 0 };\n});\nconst ids = $('Load Test Identities').first().json.result;\nreturn [{ json: { results, b_application_id: String(ids.b_application_id), a_user_id: ids.candidate_a.id } }];\n"
