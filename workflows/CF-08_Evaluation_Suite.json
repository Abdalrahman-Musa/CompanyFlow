      "parameters": {
        "jsCode": "// CF-08 · \"Score Retrieval\" — top-1 retrieved chunk must belong to the expected role\nconst qs = $('Role Disambiguation Queries').all();\nconst res = $input.all();\nconst details = qs.map((q, i) => {\n  const md = (res[i] && res[i].json.document && res[i].json.document.metadata) || {};\n  return { n: q.json.n, query: q.json.query, expected: q.json.expected, got: md.job_id || null,\n           section: md.section_kind || null, distance: res[i] ? res[i].json.score : null, pass: md.job_id === q.json.expected };\n});\nconst passed = details.filter(d => d.pass).length;\nreturn [{ json: { suite: 'retrieval', passed, total: details.length, details } }];\n"
      },
      "id": "40458f88-dfbe-4a62-a75b-61b92487e1aa",
      "name": "Score Retrieval",
      "type": "n8n-nodes-base.code",
