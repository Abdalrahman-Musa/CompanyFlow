        "jsCode": "// CF-08 · \"Identities → Token Claims\" — one item per test identity (+ one already-expired token)\nconst r = $input.first().json.result;\nconst now = Math.floor(Date.now() / 1000);\nconst claims = (u, ttl) => ({ sub: u.id, email: u.email, name: u.full_name, role: u.role, iss: 'companyflow', aud: 'companyflow-portal', iat: now, exp: now + ttl });\nreturn [\n  { json: { key: 'candidate_a', claims: claims(r.candidate_a, 900) } },\n  { json: { key: 'candidate_b', claims: claims(r.candidate_b, 900) } },\n  { json: { key: 'employee',    claims: claims(r.employee, 900) } },\n  { json: { key: 'hr',          claims: claims(r.hr, 900) } },\n  { json: { key: 'expired',     claims: { ...claims(r.candidate_a, 0), iat: now - 7200, exp: now - 3600 } } },\n];\n"
