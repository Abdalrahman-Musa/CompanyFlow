    {
      "parameters": {
        "jsCode": "// \"Authorize HR\" — only the hr role passes; everything else is denied and audited\nconst p = $input.first().json.payload || {};\nconst req = $('POST /cf/hr').first().json;\nconst b = req.body || {};\nconst ALLOWED = ['dashboard', 'candidates', 'application', 'set_status', 'audit', 'verify_audit', 'generate_slots', 'eval_runs'];\nconst key = String(b.action || '').toLowerCase().trim();\nconst denied = [];\nif (p.iss !== 'companyflow' || p.aud !== 'companyflow-portal' || !p.sub) denied.push('invalid_token_claims');\nelse if (p.role !== 'hr') denied.push(`role \"${p.role}\" is not HR staff`);\nconst invalid = [];\nif (!denied.length && !ALLOWED.includes(key)) invalid.push(`unknown action \"${key}\" (allowed: ${ALLOWED.join(', ')})`);\n\nreturn [{ json: {\n  allowed: denied.length === 0 && invalid.length === 0,\n  http_status: denied.length ? 403 : invalid.length ? 400 : 200,\n  reasons: [...denied, ...invalid],\n  action: key,\n  identity: { user_id: p.sub, role: p.role, email: p.email, name: p.name },\n  body: b,\n  ip: String((req.headers || {})['x-forwarded-for'] || '').split(',')[0].trim(),\n} }];\n"
      },
      "id": "1034c5aa-d081-445f-9d61-22b7ed86d163",
      "name": "Authorize HR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
