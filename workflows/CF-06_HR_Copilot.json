    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'HR request: ' + $('Authorize HR').first().json.body.message + '\\n\\nLive pipeline:\\n' + JSON.stringify($json.result.jobs) + '\\nNow (Cairo): ' + $json.result.now_cairo }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are the PLANNER of CompanyFlow HR Copilot. You never execute anything: you write a short, safe, step-by-step plan that an executor agent will run only AFTER an HR staff member approves it.\nExecutor tools (use these exact names): pipeline_overview (open jobs + pipeline counts) · rank_candidates (top N for one job_id) · application_details (explainable breakdown of one application_id) · screen_application (re-run screening for one application_id) · update_application_status (move one application to shortlisted/rejected/interviewed/offer/hired… with a reason) · interview_scheduler (list_slots or book for a shortlisted application_id) · hr_policy_search · job_requirements_search · hire_patterns_search.\nRules: 2–8 steps, ONE tool per step, ordered so later steps use earlier results; mark data-changing steps consequential=true; never plan a rejection without a job-related reason; never use protected characteristics (gender, age, religion, marital/military status, nationality, disability); if the request is ambiguous write an assumption instead of guessing silently."
            }
          ]
        }
      },
      "id": "ecaa1856-c4d5-4ab0-82ff-2750b2c518ba",
      "name": "Planner (LLM)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        1340,
        -260
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"goal\": {\n      \"type\": \"string\"\n    },\n    \"assumptions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"steps\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"step\": {\n            \"type\": \"integer\"\n          },\n          \"tool\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"pipeline_overview\",\n              \"rank_candidates\",\n              \"application_details\",\n              \"screen_application\",\n              \"update_application_status\",\n              \"interview_scheduler\",\n              \"hr_policy_search\",\n              \"job_requirements_search\",\n              \"hire_patterns_search\"\n            ]\n          },\n          \"purpose\": {\n            \"type\": \"string\"\n          },\n          \"inputs\": {\n            \"type\": \"string\",\n            \"description\": \"Tool inputs as short text, e.g. job_id=SOC-L1, limit=3\"\n          },\n          \"consequential\": {\n            \"type\": \"boolean\",\n            \"description\": \"true if the step changes data (status, booking, re-screening)\"\n          }\n        },\n        \"required\": [\n          \"step\",\n          \"tool\",\n          \"purpose\",\n          \"inputs\",\n          \"consequential\"\n        ]\n      }\n    },\n    \"risks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"goal\",\n    \"steps\"\n  ]\n}"
      },
