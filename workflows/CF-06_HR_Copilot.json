    {
      "parameters": {
        "jsCode": "// \"Authorize HR\" — only the hr role passes; everything else is denied and audited\nconst p = $input.first().json.payload || {};\nconst req = $('POST /cf/hr/copilot').first().json;\nconst b = req.body || {};\nconst ALLOWED = ['plan', 'execute', 'chat'];\nconst key = String(b.mode || '').toLowerCase().trim();\nconst denied = [];\nif (p.iss !== 'companyflow' || p.aud !== 'companyflow-portal' || !p.sub) denied.push('invalid_token_claims');\nelse if (p.role !== 'hr') denied.push(`role \"${p.role}\" is not HR staff`);\nconst invalid = [];\nif (!denied.length && !ALLOWED.includes(key)) invalid.push(`unknown mode \"${key}\" (allowed: ${ALLOWED.join(', ')})`);\nif (!denied.length && !invalid.length) {\n  if ((key === 'plan' || key === 'chat') && !String(b.message || '').trim()) invalid.push('message is required');\n  if (key === 'execute' && !(parseInt(b.plan_id, 10) > 0)) invalid.push('plan_id is required to execute');\n}\nreturn [{ json: {\n  allowed: denied.length === 0 && invalid.length === 0,\n  http_status: denied.length ? 403 : invalid.length ? 400 : 200,\n  reasons: [...denied, ...invalid],\n  mode: key,\n  identity: { user_id: p.sub, role: p.role, email: p.email, name: p.name },\n  body: b,\n  ip: String((req.headers || {})['x-forwarded-for'] || '').split(',')[0].trim(),\n} }];\n"
      },
