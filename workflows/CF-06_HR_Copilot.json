    {
      "parameters": {
        "jsCode": "// CF-06 · \"Build Executor Prompt\" — turns the HR-approved plan into the agent's instructions\nconst r = $input.first().json.result;\nconst steps = (r.plan.steps || []).map(s => `${s.step}. [${s.tool}] ${s.purpose} — inputs: ${s.inputs}`).join('\\n');\nreturn [{ json: {\n  plan_id: r.plan_id,\n  agent_input: `EXECUTE APPROVED PLAN #${r.plan_id}\\nOriginal HR request: ${r.request}\\nGoal: ${r.plan.goal}\\n\\nSteps:\\n${steps}\\n\\n` +\n    `Execute the steps in order using your tools. After the last step reply with: a one-line outcome, then one line per step \"✓/✗ step N — what happened\".`,\n} }];\n"
      },
      "id": "1bc74745-4ab9-494d-ace2-87d1694838ce",
      "name": "Build Executor Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        -20
      ]
    },
    {
      "parameters": {
        "jsCode": "// CF-06 · \"Build Chat Prompt\" — direct question, no plan\nconst a = $('Authorize HR').first().json;\nreturn [{ json: { plan_id: null, agent_input: String(a.body.message || '').slice(0, 3000) } }];\n"
      },
      "id": "7f0126d5-60d4-4383-9196-f5ec0cd05fab",
      "name": "Build Chat Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.agent_input }}",
        "options": {
          "systemMessage": "=You are CompanyFlow HR Copilot, the assistant for HR STAFF. Verified user: {{ $('Authorize HR').first().json.identity.name }} (role: hr). Today is {{ $now.setZone('Africa/Cairo').toFormat('cccc d LLLL yyyy, HH:mm') }} (Cairo time).\nYou help run recruitment: rank candidates, explain screening results, update statuses, re-run screening, schedule interviews and answer policy questions.\nRULES\n- Use tools for every fact. Never invent candidates, scores, IDs or slots. Valid job IDs come from pipeline_overview.\n- Screening scores are RECOMMENDATIONS from a deterministic rubric; HR decides. When you report a score give the main reasons (must-have matched / missing).\n- Never use protected characteristics (gender, age, religion, marital or military status, nationality, disability) in any reasoning.\n- A rejection needs a job-related reason; if HR did not give one, ask for it instead of calling the tool.\n- Candidates appear as candidate codes until shortlisted (blind screening). Do not try to reveal identities.\n- When executing an approved plan, follow its steps in order; if a step fails, continue with independent steps and report it.\n- Be concise; use short bullet lists for rankings.",
          "maxIterations": 14,
          "returnIntermediateSteps": true
        }
      },
      "id": "040e5d5a-905d-4e94-9d8c-e81a1dc4d6b8",
      "name": "HR Copilot Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        1840,
        120
      ],
