    {
      "parameters": {
        "jsCode": "// CF-01 · \"Validate Auth Request\" — input validation before anything touches the database\nconst req = $input.first().json;\nconst b = req.body || {};\nconst h = req.headers || {};\nconst action = String(b.action || '').toLowerCase().trim();\nconst email = String(b.email || '').trim().toLowerCase();\nconst password = String(b.password || '');\nconst errors = [];\nif (!['login', 'register'].includes(action)) errors.push('action must be \"login\" or \"register\"');\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email) || email.length > 120) errors.push('a valid email is required');\nif (!password || password.length > 128) errors.push('password is required (max 128 characters)');\nif (action === 'register') {\n  if (password.length < 10 || !/[A-Za-z]/.test(password) || !/\\d/.test(password)) errors.push('password needs at least 10 characters with letters and numbers');\n  if (String(b.full_name || '').trim().length < 3) errors.push('full_name is required');\n}\nreturn [{ json: {\n  ok: errors.length === 0, errors, action, email, password,\n  full_name: String(b.full_name || '').trim().slice(0, 120),\n  phone: String(b.phone || '').trim().slice(0, 30),\n  ip: String(h['x-forwarded-for'] || h['x-real-ip'] || '').split(',')[0].trim(),\n  user_agent: String(h['user-agent'] || '').slice(0, 200),\n} }];\n"
      },
      "id": "dcd49d85-3dec-4bb7-aab1-a5ba8dc23ea0",
      "name": "Validate Auth Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
