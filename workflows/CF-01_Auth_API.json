        "responseBody": "={{ { token: $json.token, token_type: 'Bearer', expires_in: ($('Credentials OK?').first().json.result.user.role === 'candidate' ? 4 : 8) * 3600, user: { name: $('Credentials OK?').first().json.result.user.full_name, role: $('Credentials OK?').first().json.result.user.role, email: $('Credentials OK?').first().json.result.user.email } } }}",
