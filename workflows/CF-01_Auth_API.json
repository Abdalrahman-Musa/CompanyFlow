        "httpMethod": "POST",
        "path": "cf/auth",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "808731d0-82e1-4fa0-aaef-437245d293fd",
      "name": "POST /cf/auth",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
