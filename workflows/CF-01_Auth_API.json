        "claimsJson": "={{ JSON.stringify({ sub: $json.result.user.id, email: $json.result.user.email, name: $json.result.user.full_name, role: $json.result.user.role, dept: $json.result.user.department, iss: 'companyflow', aud: 'companyflow-portal', iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + ($json.result.user.role === 'candidate' ? 4 : 8) * 3600 }) }}",
        "options": {
          "algorithm": "HS256"
        }
      },
